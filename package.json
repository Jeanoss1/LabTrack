{
  "name": "labtrack",
  "version": "1.1.0",
  "description": "LabTrack - Sistema de gestión de préstamos de equipos de laboratorio (Firebase)",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "serve app -l 5000",
    "seed": "node seed.js",
    "reset": "node seed.js --reset",
    "test:unit": "node --test tests/unit/reglas.test.js",
    "test:e2e": "mocha",
    "test:e2e:testomat": "mocha --reporter @testomatio/reporter/mocha",
    "deploy": "npx firebase-tools deploy",
    "test:seguridad": "node --test tests/seguridad/reglas_firestore.test.js"
  },
  "dependencies": {
    "firebase": "13.2.0"
  },
  "devDependencies": {
    "@testomatio/reporter": "^2.23.0",
    "mocha": "^12.0.3",
    "selenium-webdriver": "^4.51.0",
    "serve": "^14.2.7"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6",
    "compression": "^1.8.2",
    "glob": "^14.0.4",
    "minimatch": "^11.0.5"
  }
}
